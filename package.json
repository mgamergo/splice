{
  "name": "splice",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=@splice/web",
    "build:web": "turbo run build --filter=@splice/web",
    "lint": "eslint apps/web/src apps/server/src packages/bridge/src --ext .ts,.tsx",
    "lint:fix": "eslint apps/web/src apps/server/src packages/bridge/src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/server && tsc --noEmit -p packages/bridge",
    "test": "bun test",
    "splice": "bun apps/server/src/cli.ts",
    "splice:mcp": "bun apps/server/src/cli.ts mcp",
    "bench": "bun bench/run.ts"
  },
  "dependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "next": "^16.1.3",
    "opencut-wasm": "^0.2.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "playwright-core": "1",
    "prettier": "^3.8.3",
    "turbo": "^2.8.20",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
